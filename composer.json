{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "stilling/snbt-parser",
	"description": "Parse and write Minecraft SNBT (stringified NBT) in PHP, as native PHP values or typed tags.",
	"keywords": ["minecraft", "snbt", "nbt", "parser", "stringified nbt", "minecraft data", "nbt parser", "data get"],
	"license": "MIT",
	"authors": [
		{
			"name": "Michael Stilling",
			"email": "git@stilling.dev"
		}
	],
	"support": {
		"issues": "https://github.com/m-stilling/snbt-parser-php/issues",
		"source": "https://github.com/m-stilling/snbt-parser-php"
	},
	"require": {
		"php": "^8.3"
	},
	"suggest": {
		"ext-intl": "Needed to parse the \\N{name} string escape"
	},
	"require-dev": {
		"pestphp/pest": "^4.0 || ^5.0",
		"phpstan/phpstan": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Stilling\\SNBTParser\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "pest",
		"analyse": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
